name: Keep Supabase awake
on:
  schedule:
    - cron: "0 */8 * * *"   # three times a day
  workflow_dispatch:
jobs:
  ping:
    runs-on: ubuntu-latest
    steps:
      - run: |
          curl -fsS "https://spkiusgoctaygjcxunqz.supabase.co/rest/v1/keepalive?select=id" \
            -H "apikey: ${{ secrets.SUPABASE_ANON_KEY }}" \
            -H "Authorization: Bearer ${{ secrets.SUPABASE_ANON_KEY }}"
